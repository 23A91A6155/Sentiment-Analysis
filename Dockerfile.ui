# ============================================
# Dockerfile.ui - Sentiment Analysis UI
# ============================================
FROM python:3.11-slim

# Prevent Python from buffering stdout/stderr
ENV PYTHONUNBUFFERED=1

# Install curl for container healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install dependencies first (leverages Docker layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY src/ ./src/

# Configurable port via build arg and environment variable
ARG UI_PORT=8501
ENV UI_PORT=${UI_PORT}

EXPOSE ${UI_PORT}

# Run the Streamlit application in headless mode
CMD streamlit run src/ui.py --server.port ${UI_PORT} --server.address 0.0.0.0 --server.headless true
