# ===========================================
# Sentiment Analysis System - Environment Variables
# ===========================================

# --- API Configuration ---
API_HOST=0.0.0.0
API_PORT=8000

# --- UI Configuration ---
UI_PORT=8501

# --- Model Configuration ---
MODEL_PATH=/app/model_output
MODEL_NAME=distilbert-base-uncased

# --- Training Hyperparameters ---
LEARNING_RATE=2e-5
BATCH_SIZE=16
NUM_EPOCHS=3

# --- API URL (used by UI to connect to backend) ---
API_URL=http://api:8000
